# Contraseña del panel de administración. Obligatoria. Usa una cadena larga y única.
ADMIN_PASSWORD=cambia-esta-contrasena-de-ejemplo

# Secreto para firmar cookies y sesiones. Obligatorio, mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# Puerto HTTP.
PORT=3000

# Archivo SQLite persistente. En Render/Railway apunta al disco persistente.
DB_PATH=./data/app.db

# URL pública exacta con la que se abrirá la app (sin diagonal final).
PUBLIC_URL=http://localhost:3000

# En local usa development. En producción con HTTPS usa production.
NODE_ENV=development

# none = enlaces wa.me (recomendado). meta | twilio = envío automático.
WHATSAPP_PROVIDER=none

# El panel es ciego: esta aplicación no expone receptores ni parejas.
ADMIN_SHOW_RECEIVER_LIST=false

# Si hay un proxy inverso (Render, Railway, Nginx), cámbialo a 1.
TRUST_PROXY=0

# --- WhatsApp Cloud API (solo WHATSAPP_PROVIDER=meta) ---
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_TEMPLATE_NAME=
# WHATSAPP_META_TEMPLATE_LANG=es_MX

# --- Twilio (solo WHATSAPP_PROVIDER=twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_CONTENT_SID=
